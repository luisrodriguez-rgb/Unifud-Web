<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <!-- Gradiente de la yema -->
    <radialGradient id="yolkGrad" cx="38%" cy="36%" r="65%">
      <stop offset="0%" stop-color="#FFDE6A"/>
      <stop offset="45%" stop-color="#F5A623"/>
      <stop offset="90%" stop-color="#D97706"/>
      <stop offset="100%" stop-color="#B45309"/>
    </radialGradient>
    
    <!-- Gradiente de la clara -->
    <linearGradient id="whiteGrad" x1="25%" y1="20%" x2="80%" y2="85%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="60%" stop-color="#FFFDF7"/>
      <stop offset="100%" stop-color="#F2ECD9"/>
    </linearGradient>

    <!-- Gradiente del birrete -->
    <linearGradient id="capGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E293B"/>
      <stop offset="100%" stop-color="#0A1118"/>
    </linearGradient>

    <!-- Sombra suave del logo -->
    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#0D1B2A" flood-opacity="0.12"/>
    </filter>
  </defs>

  <g filter="url(#softGlow)">
    <!-- Cuerpo del huevo (Corte transversal) con rotación suave -->
    <g transform="rotate(-18 240 280)">
      <!-- Clara exterior -->
      <path d="M 240 100 
               C 340 100, 395 190, 395 295 
               C 395 390, 325 440, 240 440 
               C 155 440, 85 390, 85 295 
               C 85 190, 140 100, 240 100 Z" 
            fill="url(#whiteGrad)" 
            stroke="#0D1B2A" 
            stroke-width="15" 
            stroke-linejoin="round"/>

      <!-- Borde interno de profundidad del huevo -->
      <path d="M 238 120 
               C 320 120, 370 198, 370 290 
               C 370 375, 310 418, 238 418 
               C 166 418, 106 375, 106 290 
               C 106 198, 156 120, 238 120 Z" 
            fill="none" 
            stroke="#E2D9C0" 
            stroke-width="7" 
            opacity="0.6"/>

      <!-- Yema circular con volumen -->
      <ellipse cx="240" cy="285" rx="72" ry="74" 
               fill="url(#yolkGrad)" 
               stroke="#0D1B2A" 
               stroke-width="12"/>

      <!-- Brillo especular en la yema -->
      <ellipse cx="218" cy="256" rx="20" ry="10" 
               transform="rotate(-25 218 256)" 
               fill="#FFFFFF" 
               opacity="0.65"/>
    </g>

    <!-- Birrete de graduación montado en la parte superior izquierda del huevo -->
    <g transform="translate(115, 60) rotate(-14 100 80)">
      <!-- Base/Cúpula del birrete -->
      <path d="M 50 82 C 50 68, 150 68, 150 82 L 142 120 C 142 135, 58 135, 58 120 Z" 
            fill="#0D1B2A" 
            stroke="#0D1B2A" 
            stroke-width="6"/>

      <!-- Rombo superior del birrete -->
      <polygon points="100,28 195,65 100,102 5,65" 
               fill="url(#capGrad)" 
               stroke="#0D1B2A" 
               stroke-width="11" 
               stroke-linejoin="round"/>

      <!-- Botón central del birrete -->
      <circle cx="100" cy="65" r="8" fill="#F5A623" stroke="#0D1B2A" stroke-width="4"/>

      <!-- Cordón / Borla (Tassel) que cuelga a la izquierda -->
      <path d="M 100 65 Q 48 78, 42 120" 
            fill="none" 
            stroke="#0D1B2A" 
            stroke-width="6" 
            stroke-linecap="round"/>
      
      <!-- Borla colgante -->
      <path d="M 42 120 L 37 150 C 37 155, 47 155, 47 150 Z" 
            fill="#0D1B2A"/>
      <circle cx="42" cy="123" r="5" fill="#F5A623"/>
    </g>
  </g>
</svg>
