<footer class="site-footer">
  <div class="container">
    <!-- Top 4 Columns Grid -->
    <div class="footer-columns-grid">
      <!-- Col 1: Brand & Identity -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-brand-logo">
          <div class="footer-logo-img">
            <img src="/logo.svg" alt="uniFud Logo" width="46" height="46" />
          </div>
          <span class="footer-brand-name">uni<span class="brand-fud">Fud</span></span>
        </a>
        <p class="footer-brand-desc">
          Plataforma tecnológica de pre-órdenes y comida express para campus universitarios. La fila puede esperar. El hambre no.
        </p>
        <div class="footer-legal-tag">
          <strong>UNIFUD S.A.S.</strong> · NIT 901968882-2<br />
          Cali, Valle del Cauca, Colombia
        </div>
      </div>

      <!-- Col 2: Plataforma -->
      <div class="footer-col">
        <p class="footer-col-title">Plataforma</p>
        <ul class="footer-links-list">
          <li><a href="/#como-funciona">Cómo Funciona</a></li>
          <li><a href="/#restaurantes">Restaurantes Aliados</a></li>
          <li><a href="/#calculadora">Calculadora de Tiempo</a></li>
          <li><a href="/aliados">Afiliar Restaurante</a></li>
          <li><a href="/reps">Embajadores Reps</a></li>
          <li><a href="/#faq">Preguntas Frecuentes</a></li>
        </ul>
      </div>

      <!-- Col 3: Sedes Activas -->
      <div class="footer-col">
        <p class="footer-col-title">Sedes Activas</p>
        <ul class="footer-links-list">
          <li><a href="/#restaurantes">Universidad ICESI</a></li>
          <li><a href="/#restaurantes">Pontificia Univ. Javeriana Cali</a></li>
          <li><a href="/#restaurantes">Lago Verde</a></li>
          <li><a href="/reps">Solicitar Nueva Sede</a></li>
        </ul>
      </div>

      <!-- Col 4: Contacto & Canales -->
      <div class="footer-col">
        <p class="footer-col-title">Contacto y Soporte</p>
        <ul class="footer-links-list contact-list">
          <li>
            <span class="contact-label">Administración:</span>
            <a href="mailto:administracion@unifudapp.com">administracion@unifudapp.com</a>
          </li>
          <li>
            <span class="contact-label">Habeas Data:</span>
            <a href="mailto:atencionalclienteunifud@gmail.com">atencionalclienteunifud@gmail.com</a>
          </li>
          <li>
            <span class="contact-label">Redes Sociales:</span>
            <a href="https://instagram.com/unifud.co" target="_blank" rel="noopener">Instagram: @unifud.co</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="footer-legal-bar">
      <div class="footer-copy">
        © 2026 uniFud. Todos los derechos reservados.
      </div>

      <div class="footer-legal-nav">
        <a href="/politica-privacidad">Política de Privacidad de Datos</a>
        <span class="legal-dot">•</span>
        <a href="/terminos-y-condiciones">Términos y Condiciones</a>
        <span class="legal-dot">•</span>
        <a href="/solicitud-de-borrado">Solicitud de borrado de cuenta y datos</a>
      </div>

      <div class="footer-direct-mail">
        <a href="mailto:administracion@unifudapp.com">administracion@unifudapp.com</a>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  .site-footer {
    background: #182933 !important;
    color: #CBD5E1 !important;
    padding: 90px 0 40px !important;
    border-top: 2px solid rgba(245, 158, 11, 0.25) !important;
    position: relative;
    z-index: 10;
    width: 100%;
    clear: both;
  }

  .footer-columns-grid {
    display: grid !important;
    grid-template-columns: 2fr 1.2fr 1.3fr 1.8fr !important;
    gap: 56px !important;
    margin-bottom: 70px !important;
    width: 100%;
  }

  .footer-col {
    display: flex !important;
    flex-direction: column !important;
  }

  .footer-brand-logo {
    display: inline-flex !important;
    align-items: center !important;
    gap: 14px !important;
    text-decoration: none !important;
    color: #FFFFFF !important;
    margin-bottom: 20px !important;
  }

  .footer-logo-img {
    width: 46px !important;
    height: 46px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .footer-brand-name {
    font-family: var(--font-heading) !important;
    font-size: 28px !important;
    font-weight: 800 !important;
    letter-spacing: -0.03em !important;
    color: #FFFFFF !important;
  }

  .footer-brand-name .brand-fud {
    font-weight: 900 !important;
  }

  .footer-brand-desc {
    font-size: 15px !important;
    line-height: 1.65 !important;
    color: #94A3B8 !important;
    margin-bottom: 20px !important;
    max-width: 360px !important;
  }

  .footer-legal-tag {
    font-size: 13px !important;
    color: #94A3B8 !important;
    line-height: 1.5 !important;
    font-weight: 500 !important;
    padding: 12px 16px !important;
    background: rgba(255, 255, 255, 0.04) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    border-radius: var(--radius-sm) !important;
    max-width: 360px !important;
  }

  .footer-legal-tag strong {
    color: #FFFFFF !important;
  }

  .footer-col-title {
    color: #FFFFFF !important;
    font-family: var(--font-heading) !important;
    font-size: 17px !important;
    font-weight: 800 !important;
    letter-spacing: 0.02em !important;
    text-transform: uppercase !important;
    margin-bottom: 24px !important;
    position: relative !important;
    padding-bottom: 10px !important;
  }

  .footer-col-title::after {
    content: '' !important;
    position: absolute !important;
    bottom: 0 !important;
    left: 0 !important;
    width: 28px !important;
    height: 3px !important;
    background: var(--amber-400) !important;
    border-radius: 2px !important;
  }

  .footer-links-list {
    list-style: none !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 14px !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .footer-links-list li {
    list-style: none !important;
  }

  .footer-links-list li a {
    color: #94A3B8 !important;
    text-decoration: none !important;
    font-size: 15px !important;
    font-weight: 500 !important;
    transition: var(--transition) !important;
    display: inline-block !important;
  }

  .footer-links-list li a:hover {
    color: var(--amber-300) !important;
    transform: translateX(4px) !important;
  }

  .contact-list {
    gap: 16px !important;
  }

  .contact-label {
    display: block !important;
    font-size: 12px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.06em !important;
    color: #94A3B8 !important;
    font-weight: 700 !important;
    margin-bottom: 2px !important;
  }

  .contact-list li a {
    color: #E2E8F0 !important;
    font-size: 14px !important;
  }

  .footer-legal-bar {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    flex-wrap: wrap !important;
    gap: 24px !important;
    padding-top: 36px !important;
    border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
    font-size: 14px !important;
    width: 100%;
  }

  .footer-copy {
    color: #94A3B8 !important;
    font-weight: 500 !important;
  }

  .footer-legal-nav {
    display: flex !important;
    align-items: center !important;
    flex-wrap: wrap !important;
    gap: 16px !important;
  }

  .footer-legal-nav a {
    color: var(--amber-400) !important;
    text-decoration: underline !important;
    font-weight: 600 !important;
    transition: var(--transition) !important;
  }

  .footer-legal-nav a:hover {
    color: #FFFFFF !important;
  }

  .legal-dot {
    color: #475569 !important;
  }

  .footer-direct-mail a {
    color: #CBD5E1 !important;
    text-decoration: underline !important;
    font-weight: 600 !important;
    transition: var(--transition) !important;
  }

  .footer-direct-mail a:hover {
    color: var(--amber-400) !important;
  }

  @media (max-width: 1080px) {
    .footer-columns-grid {
      grid-template-columns: 1fr 1fr !important;
      gap: 40px !important;
    }
  }

  @media (max-width: 768px) {
    .site-footer {
      padding: 48px 0 28px !important;
    }
    .footer-columns-grid {
      grid-template-columns: 1fr !important;
      gap: 32px !important;
      margin-bottom: 36px !important;
    }
    .footer-col {
      width: 100% !important;
      max-width: 100% !important;
    }
    .footer-brand-desc {
      max-width: 100% !important;
    }
    .footer-links-list li a, .footer-direct-mail a {
      word-break: break-word !important;
    }
    .footer-legal-bar {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 14px !important;
    }
    .footer-legal-nav {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 8px !important;
    }
    .legal-dot {
      display: none !important;
    }
  }
</style>
